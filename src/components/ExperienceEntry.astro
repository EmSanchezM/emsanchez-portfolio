---
interface Props {
  role: string;
  company: string;
  description: string;
  time: string;
  detailsUrl?: string;
}

const { role, company, description, time, detailsUrl } = Astro.props;
---

<div class="exp-entry">
  <div class="exp-entry__left">
    <span class="exp-entry__date">{time}</span>
    <h3 class="exp-entry__role">{role}</h3>
    <p class="exp-entry__company">{company}</p>
  </div>
  <div class="exp-entry__right">
    <p class="exp-entry__description">{description}</p>
    {detailsUrl && (
      <a href={detailsUrl} class="exp-entry__link">
        View details
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    )}
  </div>
</div>

<style>
  .exp-entry__link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2rem;
    color: var(--primary);
    font-family: var(--ff-headline);
    font-weight: var(--fw-bold);
    font-size: var(--fs-label-md);
    transition: var(--transition);
  }

  .exp-entry__link:hover {
    gap: 1.2rem;
  }

  .exp-entry {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 4rem 1.5rem;
    border-top: 1px solid rgba(68, 70, 84, 0.2);
    transition: var(--transition);
  }

  .exp-entry:last-child {
    border-bottom: 1px solid rgba(68, 70, 84, 0.2);
  }

  .exp-entry:hover {
    background-color: var(--surface-container-lowest);
  }

  .exp-entry__date {
    font-family: var(--ff-body);
    font-size: var(--fs-label-sm);
    color: var(--outline);
    text-transform: uppercase;
  }

  .exp-entry__role {
    font-family: var(--ff-headline);
    font-size: var(--fs-headline-md);
    font-weight: var(--fw-bold);
    margin-top: 0.8rem;
  }

  .exp-entry__company {
    color: var(--primary);
    font-family: var(--ff-body);
    margin-top: 0.4rem;
  }

  .exp-entry__description {
    color: var(--on-surface-variant);
    line-height: 1.6;
    max-width: 56rem;
  }

  @media screen and (min-width: 769px) {
    .exp-entry {
      flex-direction: row;
      justify-content: space-between;
      gap: 4rem;
    }

    .exp-entry__left {
      flex-shrink: 0;
      min-width: 24rem;
    }
  }
</style>
